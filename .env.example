# ─────────────────────────────────────────────────────────────────────────────
# POD Lab environment variables. Copy to .env.local for local development.
# NEVER commit real secrets. Only variables prefixed NEXT_PUBLIC_ reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role / secret key (SERVER ONLY — bypasses RLS; used by the agent worker)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 32-byte key (base64 or 64 hex chars) used to encrypt provider credentials at rest.
# Generate with: openssl rand -base64 32
POD_LAB_ENCRYPTION_KEY=

# Secret for the job-queue cron endpoint (/api/cron/jobs). Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ── AI provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER: "demo" (deterministic placeholder output, no external calls) or
# "openai_compatible" (any Chat Completions-compatible API: OpenAI, OpenRouter,
# Together, Groq, a local vLLM/Ollama gateway, or Anthropic's OpenAI-compatible endpoint).
AI_PROVIDER=demo
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4.1-mini
# Optional per-agent model overrides (AI_MODEL_<AGENT_KEY_UPPERCASE>)
# AI_MODEL_OPPORTUNITY_SCOUT=
# AI_MODEL_BRAND_ARCHITECT=
# AI_MODEL_CREATIVE_DIRECTOR=
# Optional pricing for cost estimates (USD per 1M tokens)
AI_PRICE_INPUT_PER_MTOK=0.40
AI_PRICE_OUTPUT_PER_MTOK=1.60
# Structured output mode: "json_schema" (strict schemas) or "json_object" (for providers without json_schema)
AI_RESPONSE_FORMAT=json_schema
# Token-limit parameter name: "max_tokens" (most providers) or "max_completion_tokens" (newer OpenAI models)
AI_MAX_TOKENS_PARAM=max_tokens
# Agent execution: "inline" runs a job inside the request that enqueued it; "deferred" runs it after the response.
AGENT_EXECUTION_MODE=inline

# ── Image generation (optional) ──────────────────────────────────────────────
# "none" = manual upload workflow; "openai_compatible" = /images/generations endpoint
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# ── Web research (optional) ──────────────────────────────────────────────────
# "none" = no live research (agents label all output as model knowledge / assumptions)
# "tavily" = Tavily Search API
RESEARCH_PROVIDER=none
RESEARCH_API_KEY=
# Public RDAP lookups for domain registration status (true/false)
DOMAIN_RDAP_ENABLED=false

# ── Commerce / fulfillment (optional; adapters report "Requires provider connection" until set) ──
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
FULFILL_ENGINE_API_BASE_URL=
FULFILL_ENGINE_API_KEY=
